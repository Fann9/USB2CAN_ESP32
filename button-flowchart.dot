digraph button_flow {
    graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.55"];
    node [fontname="Noto Sans CJK SC", fontsize=18, penwidth=2, color="#222222", margin="0.20,0.12"];
    edge [fontname="Noto Sans CJK SC", fontsize=14, penwidth=2, color="#222222", arrowsize=0.8];

    start [label="开始", shape=stadium, style="filled", fillcolor="#dff0d8"];
    init [label="初始化 GPIO", shape=box, style="rounded,filled", fillcolor="#dce8f8"];
    wait [label="等待按键", shape=box, style="rounded,filled", fillcolor="#fff3c4"];
    pressed [label="按键按下？", shape=diamond, style="filled", fillcolor="#f8d7da"];
    enabled [label="当前已使能？", shape=diamond, style="filled", fillcolor="#f8d7da"];
    on [label="蜂鸣器开\n流水灯", shape=box, style="rounded,filled", fillcolor="#fff3c4"];
    off [label="蜂鸣器关\n两灯熄灭", shape=box, style="rounded,filled", fillcolor="#fff3c4"];

    start -> init -> wait -> pressed;
    pressed -> wait [label="否"];
    pressed -> enabled [label="是"];
    enabled -> on [label="否"];
    enabled -> off [label="是"];
    on -> wait;
    off -> wait;
}
