digraph serial_flow {
    graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.55"];
    node [fontname="Noto Sans CJK SC", fontsize=18, penwidth=2, color="#222222", margin="0.20,0.12"];
    edge [fontname="Noto Sans CJK SC", fontsize=14, penwidth=2, color="#222222", arrowsize=0.8];

    start [label="开始", shape=ellipse, style="filled", fillcolor="#dff0d8"];
    init_gpio [label="初始化 GPIO\n两灯灭、蜂鸣器关", shape=box, style="rounded,filled", fillcolor="#dce8f8"];
    init_uart [label="初始化 UART0\n115200", shape=box, style="rounded,filled", fillcolor="#dce8f8"];
    task [label="创建串口任务", shape=box, style="rounded,filled", fillcolor="#dce8f8"];
    wait [label="等待串口数据", shape=box, style="rounded,filled", fillcolor="#fff3c4"];
    received [label="收到数据？", shape=diamond, style="filled", fillcolor="#f8d7da"];
    cache [label="缓存字符", shape=box, style="rounded,filled", fillcolor="#fff3c4"];
    enter [label="收到回车？", shape=diamond, style="filled", fillcolor="#f8d7da"];
    command [label="命令内容", shape=diamond, style="filled", fillcolor="#f8d7da"];
    group1 [label="灯组1亮\n灯组2灭", shape=box, style="rounded,filled", fillcolor="#fff3c4"];
    group2 [label="灯组1灭\n灯组2亮", shape=box, style="rounded,filled", fillcolor="#fff3c4"];
    unknown [label="提示未知命令", shape=box, style="rounded,filled", fillcolor="#fff3c4"];

    start -> init_gpio -> init_uart -> task -> wait -> received;
    received -> wait [label="否"];
    received -> cache [label="是"];
    cache -> enter;
    enter -> wait [label="否"];
    enter -> command [label="是"];
    command -> group1 [label="1212"];
    command -> group2 [label="3434"];
    command -> unknown [label="其他"];
    group1 -> wait;
    group2 -> wait;
    unknown -> wait;
}
